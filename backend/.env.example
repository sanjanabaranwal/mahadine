# Copy this file to .env for local reference only.
# NEVER commit a real .env file to GitHub.
# In Railway, set these as Project Variables (Settings > Variables) instead.

# --- Local MySQL (used when MYSQL* vars from Railway are absent) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mahadine
DB_USERNAME=root
DB_PASSWORD=root

# --- Railway MySQL plugin auto-provides these; do not set manually on Railway ---
# MYSQLHOST=
# MYSQLPORT=
# MYSQLDATABASE=
# MYSQLUSER=
# MYSQLPASSWORD=

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRATION_MS=86400000

# --- CORS (leave empty for single-service same-origin deployment) ---
CORS_ALLOWED_ORIGINS=

# --- Seeding ---
SEED_ENABLED=true

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
